    "vite-plugin-svgr": "^4.3.0"
  },
  "peerDependencies": {
    "@asgard-js/core": "0.3.78",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
