VITE_SIMPLE_BOT_PROVIDER_ENDPOINT=
VITE_MARKDOWN_BOT_PROVIDER_ENDPOINT=
VITE_PRIVATE_BOT_PROVIDER_ENDPOINT=
VITE_CONSENT_BOT_PROVIDER_ENDPOINT=
VITE_CONSENT_API_KEY=
VITE_API_KEY=
VITE_CHANNEL_HOME_BOT_PROVIDER_ENDPOINT=

# --- SourceSet File Explorer (/source-set-explorer, TASK-004) ---
# Leave every one of these unset and the route serves an in-memory volume through a fetch interceptor,
# so it works with no credentials at all. Set the endpoint to talk to a real volume instead.
#
#   edge      {EDGE}/ns/{ns}/source-set/{name}/volume        -> VITE_SOURCE_SET_API_KEY
#   platform  {API}/v1/source-set/{id}/volume                -> VITE_SOURCE_SET_TOKEN
#   platform  {API}/v1/skill-set/{id}/volume                 -> VITE_SOURCE_SET_TOKEN
#   agent hub {API}/v1/directory/{directory_id}/volume       -> VITE_SOURCE_SET_TOKEN
#
# Do NOT set the api key when the endpoint is a BFF relay: the volume key belongs to the relay, not to
# the browser.
VITE_SOURCE_SET_ENDPOINT=
VITE_SOURCE_SET_API_KEY=
VITE_SOURCE_SET_TOKEN=
VITE_SOURCE_SET_ROOT_PATH=
