{
  "name": "@asgard-js/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:core": "nx run @asgard-js/core:lint",
    "build:core": "nx run @asgard-js/core:build --skip-nx-cache --verbose",
    "watch:core": "nx build @asgard-js/core --watch",
    "lint:react": "nx run @asgard-js/react:lint",
    "build:react": "nx run @asgard-js/react:build --skip-nx-cache --verbose",
    "watch:react": "nx build @asgard-js/react --watch",
    "lint:packages": "nx run-many --target=lint --projects=@asgard-js/core,@asgard-js/react",
    "release:core": "nx run @asgard-js/core:nx-release-publish",
    "release:react": "nx run @asgard-js/react:nx-release-publish",
    "serve:react-demo": "nx serve react-demo"
  },
  "private": true,
  "dependencies": {
    "nanoid": "^5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-remove-scroll": "^2.7.1",
    "react-router-dom": "6.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "21.5.3",
    "@nx/eslint": "21.5.3",
    "@nx/eslint-plugin": "21.5.3",
    "@nx/js": "21.5.3",
    "@nx/react": "21.5.3",
    "@nx/vite": "21.5.3",
    "@nx/web": "^21.5.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^1.3.1",
    "baseline-browser-mapping": "^2.9.19",
    "es-get-iterator": "^1.1.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "lint-staged": "^16.2.7",
    "nx": "21.5.3",
    "object-is": "^1.1.6",
    "prettier": "^2.6.2",
    "sass": "^1.92.1",
    "semver": "^7.7.2",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.13.0",
    "verdaccio": "^6.0.5",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~3.8.1",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^1.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/**",
    "apps/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
